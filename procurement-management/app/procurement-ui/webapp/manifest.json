{
	"_version": "1.89.0",
	"sap.app": {
		"id": "company.procurement.procurementui",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			]
		},
		"applicationVersion": {
			"version": "0.0.1"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:lrop",
			"version": "1.32.0",
			"toolsId": "e26c1ec8-b17c-41f6-9bcc-a912a7ec91b3"
		},
		"dataSources": {
			"mainService": {
				"uri": "/procurement/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.0"
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": true,
		"dependencies": {
			"minUI5Version": "1.152.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.fe.templates": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "company.procurement.procurementui.i18n.i18n",
					"supportedLocales": [
						""
					]
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			},
			"@i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"uri": "i18n/i18n.properties",
				"settings": {
					"supportedLocales": [
						""
					]
				}
			}
		},
		"resources": {
			"css": []
		},
		"routing": {
			"config": {},
			"routes": [
				{
					"pattern": ":?query:",
					"name": "PurchaseRequestsList",
					"target": "PurchaseRequestsList"
				},
				{
					"pattern": "PurchaseRequests({key}):?query:",
					"name": "PurchaseRequestsObjectPage",
					"target": "PurchaseRequestsObjectPage"
				},
				{
					"pattern": "Summary",
					"name": "PurchaseRequestSummary",
					"target": "PurchaseRequestSummary"
				},
				{
					"pattern": "Employees",
					"name": "EmployeesList",
					"target": "EmployeesList"
				},
				{
					"pattern": "Employees({key}):?query:",
					"name": "EmployeesObjectPage",
					"target": "EmployeesObjectPage"
				},
				{
					"pattern": "Suppliers",
					"name": "SuppliersList",
					"target": "SuppliersList"
				},
				{
					"pattern": "Suppliers({key}):?query:",
					"name": "SuppliersObjectPage",
					"target": "SuppliersObjectPage"
				}
			],
			"targets": {
				"PurchaseRequestsList": {
					"type": "Component",
					"id": "PurchaseRequestsList",
					"name": "sap.fe.templates.ListReport",
					"options": {
						"settings": {
							"contextPath": "/PurchaseRequests",
							"variantManagement": "Page",
							"navigation": {
								"PurchaseRequests": {
									"detail": {
										"route": "PurchaseRequestsObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "GridTable",
										"rowCount": 10,
										"selectionMode": "None"
									}
								}
							}
						}
					}
				},
    "PurchaseRequestSummary": {
    	"type": "Component",
    	"id": "PurchaseRequestSummary",
    	"name": "sap.fe.templates.ListReport",
    	"options": {
    		"settings": {
    			"contextPath": "/PurchaseRequestSummary",
    			"variantManagement": "Page"
    		}
    	}
    },
				"PurchaseRequestsObjectPage": {
					"type": "Component",
					"id": "PurchaseRequestsObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"options": {
						"settings": {
							"editableHeaderContent": false,
							"contextPath": "/PurchaseRequests"
						}
					}
				},
				"EmployeesList": {
					"type": "Component",
					"id": "EmployeesList",
					"name": "sap.fe.templates.ListReport",
					"options": {
						"settings": {
							"contextPath": "/Employees",
							"variantManagement": "Page",
							"navigation": {
								"Employees": {
									"detail": {
										"route": "EmployeesObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable"
									}
								}
							}
						}
					}
				},
				"EmployeesObjectPage": {
					"type": "Component",
					"id": "EmployeesObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"options": {
						"settings": {
							"editableHeaderContent": false,
							"contextPath": "/Employees"
						}
					}
				},
				"SuppliersList": {
					"type": "Component",
					"id": "SuppliersList",
					"name": "sap.fe.templates.ListReport",
					"options": {
						"settings": {
							"contextPath": "/Suppliers",
							"variantManagement": "Page",
							"navigation": {
								"Suppliers": {
									"detail": {
										"route": "SuppliersObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable"
									}
								}
							}
						}
					}
				},
				"SuppliersObjectPage": {
					"type": "Component",
					"id": "SuppliersObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"options": {
						"settings": {
							"editableHeaderContent": false,
							"contextPath": "/Suppliers"
						}
					}
				}
			}
		},
		"flexBundle": false
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	},
	"sap.fe": {
		"app": {
			"enableLazyLoading": true
		}
	}
}