{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/procurement/(.*)$",
      "target": "/procurement/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^(.*)$",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    }
  ]
}
